#!/bin/bash

# 定义颜色输出
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# 获取当前分支名
CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ -z "$CURRENT_BRANCH" ]; then
    echo -e "${RED}错误: 无法获取当前分支名${NC}"
    exit 0  # 不阻止 push
fi

# 获取远程分支名
REMOTE=$(git config branch.$CURRENT_BRANCH.remote 2>/dev/null)
REMOTE_BRANCH=$(git config branch.$CURRENT_BRANCH.merge 2>/dev/null | sed 's/^refs\/heads\///')

if [ -z "$REMOTE" ] || [ -z "$REMOTE_BRANCH" ]; then
    echo -e "${YELLOW}警告: 当前分支 '$CURRENT_BRANCH' 没有关联的远程分支${NC}"
    echo -e "${YELLOW}跳过 squash 检查${NC}"
    exit 0  # 不阻止 push
fi

# 检查是否有未提交的更改
if ! git diff-index --quiet HEAD --; then
    echo -e "${YELLOW}警告: 有未提交的更改，请先提交或暂存更改${NC}"
    echo -e "${YELLOW}跳过 squash 检查${NC}"
    exit 0  # 不阻止 push
fi

# 获取本地和远程分支的差异提交数
COMMIT_COUNT=$(git rev-list --count $REMOTE/$REMOTE_BRANCH..$CURRENT_BRANCH 2>/dev/null)

# 如果获取失败或没有新提交，直接退出
if [ -z "$COMMIT_COUNT" ] || [ "$COMMIT_COUNT" -le 1 ]; then
    echo -e "${GREEN}没有需要 squash 的多个提交${NC}"
    exit 0  # 不阻止 push
fi

echo -e "${BLUE}检测到 $CURRENT_BRANCH 分支有 $COMMIT_COUNT 个新提交${NC}"

# 显示最近的提交
echo -e "${BLUE}最近的提交:${NC}"
git log --oneline -n $COMMIT_COUNT $REMOTE/$REMOTE_BRANCH..$CURRENT_BRANCH

# 询问是否要 squash
echo -e "${YELLOW}是否要在推送前 squash 这些提交? [y/N]${NC}"
read -r response
if [[ "$response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
    # 询问 squash 的数量
    echo -e "${YELLOW}要 squash 最近几个提交? (默认: $COMMIT_COUNT)${NC}"
    read -r squash_count
    
    # 如果没有输入，使用默认值
    if [ -z "$squash_count" ]; then
        squash_count=$COMMIT_COUNT
    fi
    
    # 验证输入是否为数字且不大于提交数
    if ! [[ "$squash_count" =~ ^[0-9]+$ ]] || [ "$squash_count" -gt "$COMMIT_COUNT" ]; then
        echo -e "${RED}错误: 无效的提交数量${NC}"
        exit 1  # 阻止 push
    fi
    
    # 询问提交信息
    echo -e "${YELLOW}请输入新的提交信息 (默认: 使用最近的提交信息):${NC}"
    read -r commit_message
    
    # 如果没有输入，使用最近的提交信息
    if [ -z "$commit_message" ]; then
        commit_message=$(git log -1 --pretty=%B)
    fi
    
    # 保存当前 HEAD 位置以便回滚
    ORIGINAL_HEAD=$(git rev-parse HEAD)
    
    echo -e "${BLUE}执行 squash...${NC}"
    
    # 使用 git reset 和 commit 来 squash
    git reset --soft HEAD~$squash_count && git commit -m "$commit_message"
    
    if [ $? -ne 0 ]; then
        echo -e "${RED}Squash 失败，恢复原始状态${NC}"
        git reset --hard $ORIGINAL_HEAD
        exit 1  # 阻止 push
    fi
    
    echo -e "${GREEN}Squash 成功完成！${NC}"
    echo -e "${GREEN}新的提交历史:${NC}"
    git log --oneline -n 3
    
    echo -e "${YELLOW}是否继续推送? [Y/n]${NC}"
    read -r push_response
    if [[ "$push_response" =~ ^([nN][oO]|[nN])$ ]]; then
        echo -e "${YELLOW}推送已取消${NC}"
        exit 1  # 阻止 push
    fi
    
    echo -e "${GREEN}继续推送...${NC}"
fi

exit 0  # 不阻止 push
